      <AllCalculationMethods>
        <CoreCalculationMethod name="Cellular partition coefficient method - Rodgers and Rowland" icon="CoreCalculationMethod" bbVersion="0" category="DistributionCellular">
          <Creation createdAt="5250945912402003197" createdBy="heman" creationMode="New" origin="Other" />
          <OutputFormulas>
            <KeyValue>
              <Formula id="Cellular partition coefficient method - Rodgers and Rowland.PARAM_K_rbc" name="PARAM_K_rbc" formula="K_pu_bc*fu">
                <Paths>
                  <Path path="0" as="1" dim="2" />
                  <Path path="3" as="4" />
                </Paths>
              </Formula>
              <ParameterDescriptor parameterName="Partition coefficient (blood cells/plasma)">
                <ContainerCriteria operator="And">
                  <DescriptorConditions>
                    <MatchTagCondition tag="RootContainer" />
                  </DescriptorConditions>
                </ContainerCriteria>
              </ParameterDescriptor>
            </KeyValue>
            <KeyValue>
              <Formula id="Cellular partition coefficient method - Rodgers and Rowland.PARAM_K_cell_pls_Rodgers_and_Rowland" name="PARAM_K_cell_pls_Rodgers_and_Rowland" formula="((1+X)/(1+Y)*f_iw + f_ew + (10^LogP*f_nl+(0.3*10^LogP+0.7)*f_np)/(1+Y) + (HasStrongBase ? Ka_AP*AP_T*X/(1+Y) : Ka_PR*(IsNeutral ? PR_T2PR_P_Lipoprotein : PR_T2PR_P_Albumin)))*fu">
                <Paths>
                  <Path path="0" as="1" dim="2" />
                  <Path path="5" as="6" />
                  <Path path="7" as="8" />
                  <Path path="9" as="10" />
                  <Path path="11" as="12" />
                  <Path path="13" as="14" dim="15" />
                  <Path path="16" as="17" />
                  <Path path="18" as="19" />
                  <Path path="20" as="21" />
                  <Path path="22" as="23" />
                  <Path path="24" as="25" />
                  <Path path="26" as="27" />
                  <Path path="28" as="29" />
                  <Path path="30" as="31" />
                  <Path path="32" as="33" />
                </Paths>
              </Formula>
              <ParameterDescriptor parameterName="Partition coefficient (intracellular/plasma)">
                <ContainerCriteria operator="And">
                  <DescriptorConditions>
                    <NotMatchTagCondition tag="Fat_int_Fat_cell" />
                    <MatchTagCondition tag="Neighborhood: Interstitial / Intracellular" />
                  </DescriptorConditions>
                </ContainerCriteria>
              </ParameterDescriptor>
            </KeyValue>
            <KeyValue>
              <Formula id="Cellular partition coefficient method - Rodgers and Rowland.PARAM_K_cell_pls_fat" name="PARAM_K_cell_pls_fat" formula="((1+X)/(1+Y)*f_iw + f_ew + (10^LogP_ow*f_nl+(0.3*10^LogP_ow+0.7)*f_np)/(1+Y) + (HasStrongBase ? Ka_AP*AP_T*X/(1+Y) : Ka_PR*(IsNeutral ? PR_T2PR_P_Lipoprotein : PR_T2PR_P_Albumin)))*fu">
                <Paths>
                  <Path path="0" as="1" dim="2" />
                  <Path path="5" as="6" />
                  <Path path="7" as="8" />
                  <Path path="9" as="10" />
