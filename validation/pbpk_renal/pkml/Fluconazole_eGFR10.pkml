          <FormulaCache>
            <Formulas>
              <Formula id="Cellular partition coefficient method - Rodgers and Rowland.PARAM_Ka_AP" name="PARAM_Ka_AP" formula="Max(0;Kpu_bc - (1+Z)/(1+Y)*f_iw_bc - (10^LogP*f_nl_bc + (0.3*10^LogP+0.7)*f_np_bc)/(1+Y)) * (1+Y) / AP_bc / Z">
                <Paths>
                  <Path path="13" as="14" dim="15" />
                  <Path path="3" as="36" />
                  <Path path="16" as="17" />
                  <Path path="18" as="19" />
                  <Path path="37" as="38" />
                  <Path path="39" as="40" />
                  <Path path="41" as="42" />
                  <Path path="43" as="44" />
                  <Path path="45" as="46" />
                </Paths>
              </Formula>
              <Formula id="Cellular partition coefficient method - Rodgers and Rowland.PARAM_Ka_PR" name="PARAM_Ka_PR" formula="Max(0;1/fu - 1 - (10^LogP*f_nl_p + (0.3*10^LogP+0.7)*f_np_p)/(1+Y))">
                <Paths>
                  <Path path="0" as="1" dim="2" />
                  <Path path="13" as="14" dim="15" />
                  <Path path="18" as="19" />
                  <Path path="39" as="40" />
                  <Path path="47" as="48" />
                  <Path path="49" as="50" />
                </Paths>
              </Formula>
              <Formula id="Cellular partition coefficient method - Rodgers and Rowland.PARAM_LogP_ow" name="PARAM_LogP_ow" dim="Log Units" formula="1.115 * LogP - 1.35">
                <Paths>
                  <Path path="13" as="14" dim="15" />
                </Paths>
              </Formula>
              <Formula id="Cellular partition coefficient method - Rodgers and Rowland.PARAM_Kpu_bc" name="PARAM_Kpu_bc" formula="(HCT - 1 + B2P) / fu / HCT">
                <Paths>
                  <Path path="51" as="52" />
                  <Path path="0" as="1" dim="2" />
                  <Path path="53" as="54" />
                </Paths>
              </Formula>
              <Formula id="Cellular partition coefficient method - Rodgers and Rowland.PARAM_X" name="PARAM_X" formula="X_Neutral + X_MonoproticBase + X_MonoproticAcid + X_DiproticBase + X_DiproticAcid + X_MonoproticBaseMonoproticAcid + X_TriproticAcid + X_TriproticBase + X_DiproticBaseMonoproticAcid + X_MonoproticBaseDiproticAcid">
                <Paths>
                  <Path path="55" as="56" />
                  <Path path="57" as="58" />
                  <Path path="59" as="60" />
                  <Path path="61" as="62" />
                  <Path path="63" as="64" />
                  <Path path="65" as="66" />
                  <Path path="67" as="68" />
                  <Path path="69" as="70" />
                  <Path path="71" as="72" />
                  <Path path="73" as="74" />
                </Paths>
              </Formula>
              <Formula id="Cellular partition coefficient method - Rodgers and Rowland.PARAM_X_DiproticAcid" name="PARAM_X_DiproticAcid" formula="IsDiproticAcid ? 10^(pH_IW-pKa_Acid_0) + 10^(2*pH_IW-pKa_Acid_0-pKa_Acid_1) : 0">
                <Paths>
                  <Path path="75" as="76" />
                  <Path path="77" as="78" />
                  <Path path="79" as="80" />
                  <Path path="81" as="82" />
                </Paths>
              </Formula>
              <Formula id="Cellular partition coefficient method - Rodgers and Rowland.PARAM_X_DiproticBase" name="PARAM_X_DiproticBase" formula="IsDiproticBase ? 10^(pKa_Base_1-pH_IW) + 10^(pKa_Base_0+pKa_Base_1-2*pH_IW) : 0">
                <Paths>
                  <Path path="83" as="84" />
                  <Path path="85" as="86" />
                  <Path path="87" as="88" />
                  <Path path="81" as="82" />
                </Paths>
              </Formula>
              <Formula id="Cellular partition coefficient method - Rodgers and Rowland.PARAM_X_DiproticBaseMonoproticAcid" name="PARAM_X_DiproticBaseMonoproticAcid" formula="IsDiproticBaseMonoproticAcid ? 10^(pH_IW-pKa_Acid_0) + 10^(pKa_Base_1-pH_IW) + 10^(pKa_Base_0+pKa_Base_1-2*pH_IW) : 0">
                <Paths>
                  <Path path="89" as="90" />
                  <Path path="77" as="78" />
                  <Path path="85" as="86" />
                  <Path path="87" as="88" />
                  <Path path="81" as="82" />
                </Paths>
              </Formula>
              <Formula id="Cellular partition coefficient method - Rodgers and Rowland.PARAM_X_MonoproticAcid" name="PARAM_X_MonoproticAcid" formula="IsMonoproticAcid ? 10^(pH_IW-pKa_Acid_0) : 0">
                <Paths>
                  <Path path="91" as="92" />
                  <Path path="77" as="78" />
                  <Path path="81" as="82" />
                </Paths>
              </Formula>
              <Formula id="Cellular partition coefficient method - Rodgers and Rowland.PARAM_X_MonoproticBase" name="PARAM_X_MonoproticBase" formula="IsMonoproticBase ? 10^(pKa_Base_0-pH_IW) : 0">
                <Paths>
                  <Path path="93" as="94" />
                  <Path path="85" as="86" />
                  <Path path="81" as="82" />
